<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    package="com.example.hidecamera">

    <!-- Permissions required for Background Video Recording -->
    <uses-permission android:android:name="android.permission.CAMERA" />
    <uses-permission android:android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    
    <!-- Permission for saving to Public Gallery (Scoped Storage handled in code) -->
    <uses-permission android:android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Main Screen / Option Toggle Screen -->
        <activity
            android:android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:android:name="android.intent.action.MAIN" />
                <category android:android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Secure Passcode Lock Screen -->
        <activity android:android:name=".PasscodeActivity" android:exported="false" />
        
        <!-- Private Video Viewer Screen -->
        <activity android:android:name=".VideoGalleryActivity" android:exported="false" />

        <!-- Background Video Recorder Service -->
        <service
            android:android:name=".BackgroundRecorderService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

    </application>
</manifest>

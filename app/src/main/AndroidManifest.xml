<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com">

    <!-- Sabhi permissions me standard 'android:name' key properly add kar di gayi hai -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Main Launcher Screen Registration -->
        <activity
            android:name="com.example.btmic.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Jetpack Compose View Activity Registration -->
        <activity 
            android:name="com.example.btmic.RecordingsUiActivity"
            android:exported="false" />

        <!-- Background Video Engine Service Registration -->
        <service
            android:name="com.example.btmic.BackgroundRecorderService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

    </application>
</manifest>
